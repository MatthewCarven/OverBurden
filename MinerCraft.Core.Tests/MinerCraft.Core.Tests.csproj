<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MinerCraft.Core\MinerCraft.Core.csproj" />

    <!-- The SQLite store, so the contract suite can run against the real implementation
         rather than only the in-memory stand-in. M1's InMemoryContentSource drifted from
         the shipped content and nothing said so until M3c wrote ShippedContentTests; a
         store that drifts would make every M6b-2 pipeline test a fiction. -->
    <ProjectReference Include="..\MinerCraft.Persistence\MinerCraft.Persistence.csproj" />
  </ItemGroup>

</Project>
