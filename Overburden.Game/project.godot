; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Overburden"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"
config/use_custom_user_dir.template=true
config/custom_user_dir_name.template="Overburden Alpha"

[dotnet]

project/assembly_name="Overburden.Game"
project/solution_directory="../tools/godot-sln"

[rendering]

textures/default_filters/use_nearest_mipmap_filter=true
