<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Overburden.Game</RootNamespace>
    <Nullable>enable</Nullable>
    <!-- ALPHA-PLAN decision 11: the version a player reports. The SDK appends the commit it was built
         from (InformationalVersion "0.1.0-alpha+<sha>"); Main prints it first and the HUD shows it. -->
    <!-- Bump for every zip that goes out, so a report names one build: 0.1.0-alpha went to Google Drive
         without its notices; 0.1.1-alpha carries them. -->
    <Version>0.1.1-alpha</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Overburden.Core\Overburden.Core.csproj" />

    <!-- The Godot half is the only assembly that names a concrete store. Core owns IWorldStore
         and an in-memory implementation; this reference is what brings the SQLite one, and with
         it SQLitePCLRaw's native e_sqlite3. EnableDynamicLoading above is what makes that
         resolvable at run time - Godot loads this assembly through an AssemblyLoadContext driven
         by the generated .deps.json, which is also what carries the runtimes/win-x64/native
         entry. An export is the case still unverified. -->
    <ProjectReference Include="..\Overburden.Persistence\Overburden.Persistence.csproj" />
  </ItemGroup>
</Project>
